<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ metaTitle or title }} | {{ site.name }}</title>
  <meta name="description" content="{{ metaDescription or site.description }}">
  {%- if not site.production %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/img/favicon.png" type="image/png">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ metaTitle or title }} | {{ site.name }}">
  <meta property="og:description" content="{{ metaDescription or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="en_AU">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/assets/img/og-image.png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  {%- if page.url == "/" %}
  <link rel="preload" href="/assets/img/brand/gigawatt-energy-hero-loop-poster.webp" as="image" type="image/webp" fetchpriority="high">
  {%- endif %}
  <link rel="stylesheet" href="/assets/css/main.css?v={{ build.v }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}/#business",
    "name": "{{ site.name }}",
    "legalName": "{{ site.legalName }}",
    "url": "{{ site.url }}",
    "image": "{{ site.url }}/assets/img/og-image.png",
    "logo": "{{ site.url }}/assets/img/brand/gigawatt-energy-logo.png",
    "founder": { "@type": "Person", "name": "Amrit Singh Thapa", "jobTitle": "'A' Grade Electrician & SAA Accredited Solar and Battery Installer" },
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "foundingDate": "{{ site.founded }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "{{ site.address.locality }}",
      "addressRegion": "{{ site.address.region }}",
      "postalCode": "{{ site.address.postcode }}",
      "addressCountry": "{{ site.address.country }}"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "17:00"
    },
    "areaServed": [{% for a in site.serviceAreas %}{"@type":"Place","name":"{{ a }}, VIC"}{% if not loop.last %},{% endif %}{% endfor %}],
    "sameAs": ["{{ site.social.facebook }}","{{ site.social.instagram }}","{{ site.social.tiktok }}"]
  }
  </script>
  {% block schema %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header{% if page.url == "/" %} is-overlay{% endif %}">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="{{ site.name }} home">
      <img src="/assets/img/brand/gigawatt-energy-mark.png" alt="" width="40" height="40" class="logo-mark">
      <span>Gigawatt<strong>Energy</strong></span>
    </a>
    <nav class="main-nav" aria-label="Main">
      <a href="tel:{{ site.phone }}" class="mobile-call" aria-label="Call {{ site.phoneDisplay }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.3 2.2z"/></svg></a>
      <a href="/contact/" class="mobile-cta">Get a Quote</a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">Menu</button>
      <ul id="nav-menu">
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/solar-savings-calculator/">Calculator</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="tel:{{ site.phone }}" class="nav-phone"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.3 2.2z"/></svg>{{ site.phoneDisplay }}</a></li>
        <li><a href="/contact/" class="btn btn-accent nav-cta">Get a Free Quote</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>Ready to switch to solar?</h2>
      <p>Free, no-obligation quote from an SAA-accredited local installer.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-accent" href="/contact/">Get a Free Quote</a>
      <a class="btn btn-ghost" href="tel:{{ site.phone }}">Call {{ site.phoneDisplay }}</a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-logo"><img src="/assets/img/brand/gigawatt-energy-mark.png" alt="Gigawatt Energy logo" width="48" height="48" style="margin-bottom:.7rem;display:block">Gigawatt<strong>Energy</strong></p>
      <p>{{ site.description }}</p>
      <p class="footer-cred">Registered Electrical Contractor {{ site.rec }}<br>SAA Accredited Installer · NETCC Approved Seller</p>
    </div>
    <div>
      <h3>Contact</h3>
      <ul class="footer-list">
        <li><a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></li>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li>{{ site.address.suburb }}, {{ site.address.locality }} {{ site.address.region }} {{ site.address.postcode }}</li>
        <li>{{ site.hours }}</li>
      </ul>
      <h3>Follow</h3>
      <ul class="footer-list">
        <li><a href="{{ site.social.facebook }}" rel="noopener">Facebook</a> · <a href="{{ site.social.instagram }}" rel="noopener">Instagram</a> · <a href="{{ site.social.tiktok }}" rel="noopener">TikTok</a></li>
      </ul>
    </div>
    <div>
      <h3>Services</h3>
      <ul class="footer-list">
        <li><a href="/services/solar-panel-installation/">Solar Panel Installation</a></li>
        <li><a href="/services/solar-battery-backup-installation/">Solar + Battery with Backup</a></li>
        <li><a href="/services/battery-retrofit-installation/">Battery Retrofit</a></li>
        <li><a href="/services/ev-charger-installation/">EV Charger Installation</a></li>
        <li><a href="/services/switchboard-upgrades/">Switchboard Upgrades</a></li>
        <li><a href="/solar-savings-calculator/" style="color:var(--accent)">Solar Savings Calculator</a></li>
      </ul>
    </div>
    <div>
      <h3>Service areas</h3>
      <p class="footer-areas">{% for a in site.serviceAreas %}{{ a }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {{ '' | year }} {{ site.legalName }}. All rights reserved. · <a href="/privacy/">Privacy Policy</a></p>
  </div>
</footer>
<script>
  (function(){var h=document.querySelector('.site-header.is-overlay');if(!h)return;
    var f=function(){h.classList.toggle('scrolled',window.scrollY>40||document.getElementById('nav-menu').classList.contains('open'));};
    f();window.addEventListener('scroll',f,{passive:true});document.addEventListener('click',function(){setTimeout(f,0)});})();
  const t=document.querySelector('.nav-toggle'),m=document.getElementById('nav-menu');
  t.addEventListener('click',()=>{const o=t.getAttribute('aria-expanded')==='true';t.setAttribute('aria-expanded',String(!o));m.classList.toggle('open');});
</script>
</body>
</html>
