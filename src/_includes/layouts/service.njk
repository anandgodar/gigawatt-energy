---
layout: layouts/base.njk
---
{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ title }}",
  "serviceType": "{{ serviceType or title }}",
  "provider": { "@id": "{{ site.url }}/#business" },
  "areaServed": "Melbourne, VIC, Australia",
  "description": "{{ metaDescription }}"
}
</script>
{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in faqs %}
    { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "{{ site.url }}/services/" },
    { "@type": "ListItem", "position": 3, "name": "{{ title }}", "item": "{{ site.url }}{{ page.url }}" }
  ]
}
</script>
{% endblock %}
<div class="page-hero">
  <div class="container">
    <p class="crumb"><a href="/">Home</a> / <a href="/services/">Services</a> / {{ title }}</p>
    <h1>{{ heading or title }}</h1>
    {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
  </div>
</div>
<div class="section">
  <div class="container prose">
    {{ content | safe }}
    <div class="reviews-band" style="margin-top:2.6rem">
      <div>
        <div class="rating">5.0</div>
        <div class="stars">{% for i in range(0,5) %}{{ icons.star | safe }}{% endfor %}</div>
      </div>
      <p>Fixed written quotes from the licensed electricians who do the work — rated 5.0 on Google.</p>
      <a class="btn btn-accent" href="/contact/">Get a free quote</a>
    </div>
  </div>
</div>
{% if faqs %}
<div class="section section-alt">
  <div class="container">
    <div class="section-head">
      <p class="kicker">FAQs</p>
      <h2>{{ title }} — common questions</h2>
    </div>
    <div class="faq" style="max-width:760px">
      {% for f in faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}
<div class="section">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Related services</p>
      <h2>Often installed together</h2>
    </div>
    <div class="grid grid-4">
      {% if page.url != "/services/solar-panel-installation/" %}<div class="card"><h3>Solar Panels</h3><p>Tier-one panels, custom-designed.</p><a class="card-link" href="/services/solar-panel-installation/">Learn more</a></div>{% endif %}
      {% if page.url != "/services/solar-battery-backup-installation/" %}<div class="card"><h3>Solar + Battery</h3><p>Power day and night, with backup.</p><a class="card-link" href="/services/solar-battery-backup-installation/">Learn more</a></div>{% endif %}
      {% if page.url != "/services/battery-retrofit-installation/" %}<div class="card"><h3>Battery Retrofit</h3><p>Add storage to existing solar.</p><a class="card-link" href="/services/battery-retrofit-installation/">Learn more</a></div>{% endif %}
      {% if page.url != "/services/ev-charger-installation/" %}<div class="card"><h3>EV Charger</h3><p>Safe home and business charging.</p><a class="card-link" href="/services/ev-charger-installation/">Learn more</a></div>{% endif %}
      {% if page.url != "/services/switchboard-upgrades/" %}<div class="card"><h3>Switchboard Upgrades</h3><p>Compliant, solar- and EV-ready.</p><a class="card-link" href="/services/switchboard-upgrades/">Learn more</a></div>{% endif %}
    </div>
  </div>
</div>
