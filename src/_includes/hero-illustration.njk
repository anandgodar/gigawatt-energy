<svg viewBox="0 0 560 420" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a home at dusk with solar panels, a home battery and an electric car charging" class="hero-art">
  <defs>
    <linearGradient id="dusk" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#15384c"/><stop offset=".65" stop-color="#2b5468"/><stop offset="1" stop-color="#b0683a"/>
    </linearGradient>
    <linearGradient id="panelg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2e6f8e"/><stop offset="1" stop-color="#173c50"/>
    </linearGradient>
    <radialGradient id="glow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#f2a01f" stop-opacity=".9"/><stop offset="1" stop-color="#f2a01f" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <!-- sky -->
  <rect x="0" y="0" width="560" height="330" rx="18" fill="url(#dusk)"/>
  <!-- setting sun -->
  <circle cx="470" cy="300" r="85" fill="url(#glow)"/>
  <circle cx="470" cy="300" r="30" fill="#f6b74a"/>
  <!-- stars -->
  <g fill="#e8f0f4" opacity=".8">
    <circle cx="60" cy="48" r="1.8"/><circle cx="140" cy="30" r="1.3"/><circle cx="235" cy="56" r="1.6"/><circle cx="330" cy="26" r="1.3"/><circle cx="90" cy="95" r="1.2"/><circle cx="395" cy="70" r="1.5"/>
  </g>
  <!-- ground -->
  <rect x="0" y="302" width="560" height="118" rx="18" fill="#10242f"/>
  <!-- house body -->
  <rect x="88" y="188" width="222" height="118" fill="#e9e2d2"/>
  <!-- roof -->
  <path d="M70 192 199 108l129 84z" fill="#3c4852"/>
  <!-- solar panels on roof -->
  <g transform="rotate(-33 199 108)">
    <rect x="118" y="140" width="56" height="38" rx="3" fill="url(#panelg)" stroke="#8fd0e8" stroke-width="1.5"/>
    <rect x="180" y="140" width="56" height="38" rx="3" fill="url(#panelg)" stroke="#8fd0e8" stroke-width="1.5"/>
    <rect x="242" y="140" width="56" height="38" rx="3" fill="url(#panelg)" stroke="#8fd0e8" stroke-width="1.5"/>
    <path d="M118 159h180M146 140v38M208 140v38M270 140v38" stroke="#8fd0e8" stroke-width="1"/>
  </g>
  <!-- warm lit windows: the house that stays lit -->
  <rect x="110" y="212" width="40" height="34" rx="3" fill="#f6b74a"/>
  <rect x="166" y="212" width="40" height="34" rx="3" fill="#f6b74a"/>
  <path d="M130 212v34M110 229h40M186 212v34M166 229h40" stroke="#b0683a" stroke-width="2"/>
  <!-- door -->
  <rect x="226" y="236" width="30" height="70" rx="3" fill="#2f3b44"/>
  <circle cx="250" cy="272" r="2.5" fill="#f6b74a"/>
  <!-- home battery on wall -->
  <rect x="272" y="236" width="26" height="52" rx="4" fill="#1b2a33" stroke="#8fd0e8" stroke-width="1.5"/>
  <path d="M287 246l-8 12h10l-8 12" stroke="#f2a01f" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="277" y="278" width="16" height="4" rx="2" fill="#2e6f8e"/>
  <!-- EV + charger -->
  <g>
    <rect x="384" y="282" width="10" height="24" rx="2" fill="#1b2a33" stroke="#8fd0e8"/>
    <path d="M389 282v-10c0-5 4-7 8-7h12" stroke="#8fd0e8" stroke-width="2" fill="none"/>
    <!-- car -->
    <path d="M404 290c4-12 12-18 30-18s27 6 31 18l6 2c3 1 5 3 5 6v6a4 4 0 0 1-4 4h-76a4 4 0 0 1-4-4v-6c0-3 2-5 5-6z" fill="#355261"/>
    <path d="M414 288c3-8 9-12 20-12s17 4 20 12z" fill="#8fd0e8" opacity=".85"/>
    <circle cx="418" cy="308" r="8" fill="#10242f" stroke="#8fd0e8" stroke-width="2"/>
    <circle cx="456" cy="308" r="8" fill="#10242f" stroke="#8fd0e8" stroke-width="2"/>
    <!-- charge light -->
    <circle cx="409" cy="294" r="3" fill="#7de3a0"/>
  </g>
  <!-- gum tree silhouette -->
  <g fill="#0c1d26">
    <rect x="42" y="250" width="7" height="56"/>
    <ellipse cx="45" cy="236" rx="26" ry="20"/>
    <ellipse cx="28" cy="252" rx="16" ry="12"/>
  </g>
  <!-- power flow dashes from panels to battery -->
  <path d="M258 170c30 18 32 40 28 60" stroke="#f2a01f" stroke-width="2" stroke-dasharray="2 7" fill="none" opacity=".9"/>
</svg>
