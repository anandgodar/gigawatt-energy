      <p>Daily notes and videos from real installations across Melbourne's north and west.</p>
    </div>
    <div class="grid grid-3">
      {% for post in collections.posts | reverse %}{% if loop.index <= 3 %}
      <div class="card post-card">
        <span class="post-tag">{{ post.data.tags[0] if post.data.tags else "Field notes" }}</span>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.metaDescription }}</p>
        <p class="post-meta" style="margin:0.8rem 0 0">{{ post.date | readableDate }}</p>
      </div>
      {% endif %}{% endfor %}
      {% if (collections.posts | length) < 3 %}
      <div class="card" style="background:var(--dusk);color:#fff;border:0;display:flex;flex-direction:column;justify-content:center">
        <h3 style="color:#fff">New posts daily</h3>
