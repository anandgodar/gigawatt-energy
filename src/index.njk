</dialog>

<script>
(function(){
  var v=document.querySelector('.mhero-video'), hero=document.querySelector('.mhero');
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saveData=navigator.connection&&navigator.connection.saveData;
  if(v && !reduce && !saveData){
    v.muted=true; v.defaultMuted=true; v.setAttribute('muted','');
    v.src=v.dataset.src;
    v.addEventListener('playing',function(){hero.classList.add('is-playing');},{once:true});
    var tryPlay=function(){var p=v.play();if(p&&p.catch)p.catch(function(){});};
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(es){es.forEach(function(e){e.isIntersecting?tryPlay():v.pause();});},{threshold:.15}).observe(hero);
    } else tryPlay();
    // live day/dusk/night indicator, synced to the loop's three shots
    var steps=[].slice.call(document.querySelectorAll('.scene-steps li')), last=-1;
    v.addEventListener('timeupdate',function(){
      // exact crossfade midpoints of the 9.63s loop: day->dusk 3.23s, dusk->night 6.47s, night->day 9.03s
      var t=v.currentTime, i=t<3.23?0:(t<6.47?1:(t<9.03?2:0));
      if(i!==last){steps.forEach(function(s,k){s.classList.toggle('on',k===i);});last=i;}
    });
  }
  // quote: a chip = wizard step 1; open the dialog straight at step 2
  var dlg=document.getElementById('quote-dialog');
  if(!dlg||!dlg.showModal) return;
  var w=dlg.querySelector('.quote-widget');
  function openAt(service){
    if(service){var r=w.querySelector('[name=service][value="'+service+'"]');if(r)r.checked=true;}
    dlg.showModal();
    if(service){var n=w.querySelector('[data-step="1"] .qw-next');if(n&&!w.querySelector('[data-step="1"]').hidden)n.click();}
  }
  document.querySelectorAll('.mq-chip').forEach(function(c){c.addEventListener('click',function(){openAt(c.dataset.service);});});
  document.querySelectorAll('a.nav-cta, a.mobile-cta').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();openAt(null);});});
  dlg.querySelector('.qd-close').addEventListener('click',function(){dlg.close();});
  dlg.addEventListener('click',function(e){if(e.target===dlg)dlg.close();});
})();
</script>

